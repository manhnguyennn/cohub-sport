# Set to "mock" to use local mock data (default), "api" to call backend.
NEXT_PUBLIC_DATA_SOURCE=mock

# Real API base URL — only used when NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Toggle simulated network latency on mock services (ms). 0 = no delay.
NEXT_PUBLIC_MOCK_LATENCY_MS=150
